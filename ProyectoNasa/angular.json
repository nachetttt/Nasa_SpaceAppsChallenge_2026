  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "mision-zafiro-kids": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/mision-zafiro-kids",
